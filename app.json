{
  "expo": {
    "name": "Spotrive",
    "slug": "spotrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spotrive",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080A0F",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#080A0F",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotrive.app"
    },
    "android": {
      "package": "com.spotrive.app",
      "navigationBar": {
        "backgroundColor": "#080A0F"
      },
      "adaptiveIcon": {
        "backgroundColor": "#080A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spotrive utilise ta position pour mesurer la distance, la durée et l'allure de tes courses et de tes marches.",
          "locationWhenInUsePermission": "Spotrive utilise ta position pour mesurer la distance, la durée et l'allure de tes courses et de tes marches.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
